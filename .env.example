# Copy this file to `.env` and fill in your key:
#   cp .env.example .env
#
# The DeepSeek API key used to generate feed names, descriptions, and
# categories. Get one from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the DeepSeek model (default: deepseek-chat).
# DEEPSEEK_MODEL=deepseek-chat

# Optional: network timeouts (seconds).
# CONNECT_TIMEOUT=5     # time to establish a connection (default 5)
# REQUEST_TIMEOUT=10    # time to wait for a response (default 10)
# DEEPSEEK_TIMEOUT=60   # time to wait for a DeepSeek API response (default 60)
# POLITE_DELAY=0.75     # seconds between network calls (default 0.75)

# Optional: concurrency and coverage limits.
# MAX_WORKERS=12        # parallel HTTP probes (default 12)
# FEEDS_PER_DOMAIN=3    # distinct feeds to capture per domain (default 3)
